; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ever Deeper"
config/version="0.42.0-dev.5"
run/main_scene="res://scenes/main/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Ever Deeper- Godot Production Port"
config/custom_user_dir_name.ever_deeper_dev="Ever Deeper- Godot Development Port"
config/features=PackedStringArray("4.7")
run/max_fps=60
boot_splash/bg_color=Color(0.0039, 0.0118, 0.0078, 1)
boot_splash/image="res://assets/branding/ever-deeper-boot-splash-landscape-v1.png"
config/icon="res://assets/branding/ever-deeper-app-icon.png"

[autoload]

GameData="*res://scripts/autoload/game_data.gd"
RunState="*res://scripts/state/run_state.gd"
AudioDirector="*res://scripts/audio/audio_director.gd"
AchievementService="*res://scripts/progression/achievement_service.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale=1.1
window/handheld/orientation=4

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
