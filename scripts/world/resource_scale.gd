static func bounds(texture: Texture2D) -> Rect2:
	if texture == null: return Rect2()
	var path: String = String(texture.get_meta("scale_source", texture.resource_path))
	return BOUNDS.get(path, Rect2(Vector2.ZERO, texture.get_size()))

static func factor(texture: Texture2D, visible_size: Vector2) -> float:
	var rect: Rect2 = bounds(texture)
	if rect.size.x <= 0 or rect.size.y <= 0: return 1.0
	return minf(visible_size.x / rect.size.x, visible_size.y / rect.size.y)

static func draw_rect(texture: Texture2D, center: Vector2, visible_size: Vector2) -> Rect2:
	var ratio: float = factor(texture, visible_size)
	return Rect2(center - bounds(texture).get_center() * ratio, texture.get_size() * ratio)

static func fit(sprite: Sprite2D, visible_size: Vector2) -> void:
	if sprite.texture == null: return
	sprite.scale = Vector2.ONE * factor(sprite.texture, visible_size)
	sprite.offset = sprite.texture.get_size() * 0.5 - bounds(sprite.texture).get_center()
