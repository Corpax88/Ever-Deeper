+func _capture_presented_frame() -> void:
+	if not recording: return
+	var img := root.get_texture().get_image()
+	if img.get_size() != Vector2i(1696,780):
+		_check(false, "Actual captured framebuffer must be 1696x780")
+		quit(3)
+		return
+	var index: int = rendered_frames.size()
+	var file: String = "frames/frame-%05d.jpg" % index
+	if img.save_jpg(output.path_join(file),0.94) != OK:
+		_check(false, "Actual captured framebuffer writes successfully")
+		quit(3)
+		return
+	var count: int = int(capture_stage_counts.get(stage,0))
+	capture_stage_counts[stage] = count + 1
+	if count == 0 or count == 10:
+		img.save_png(output.path_join("%s-%02d.png" % [stage,count]))
+	var pose: Dictionary = player.visual.tool_visual_snapshot()
+	var point: Vector2 = player.get_global_transform_with_canvas().origin
+	rendered_frames.append({"file":file,"size":[img.get_width(),img.get_height()],"stage":stage,"time":elapsed,
+		"position":[player.global_position.x,player.global_position.y],"screen_position":[point.x,point.y],
+		"pose":pose,"moving":player.is_actually_moving(),"mining":world.mining_active,"progress":player.mining_visual_progress})
