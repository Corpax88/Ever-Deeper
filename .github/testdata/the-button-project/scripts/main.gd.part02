			if announce: _say(_counter_line("spam"))
		"dodge":
			_teleport_button()
			dodge_escapes_left = rng.randi_range(1, 3)
			main_button.text = "TRY"
			if announce: _say(_pick_fresh(["Catch me.", "Go ahead.", "This one has opinions."]))
		"fade":
			_teleport_button()
			main_button.modulate.a = rng.randf_range(0.16, 0.42)
			main_button.text = "HERE"
			if announce: _say(_pick_fresh(["I'm still here.", "Eyes open.", "Visibility is a privilege."]))
		"corner":
			_place_in_corner()
			main_button.size = Vector2(175, 92)
			main_button.text = "HI"
			if announce: _say(_pick_fresh(["Look around.", "Center is overrated.", "Found the corner?"]))
		"shrink":
			_place_button_center()
			shrink_clicks_left = rng.randi_range(2, 4)
			main_button.text = str(shrink_clicks_left)
			if announce: _say(_pick_fresh(["A few more.", "Each one costs size.", "Keep going."]))
		"sequence":
			_place_button_center()
			sequence_left = rng.randi_range(2, 4)
			sequence_expected = 1
			main_button.text = "1"
			if announce: _say(_pick_fresh(["In order.", "Count with me.", "Simple. Probably."]))
		"fake_lock":
			_place_button_center()
			fake_lock = true
			main_button.text = "DISABLED"
			if announce: _say(_pick_fresh(["I disabled it.", "Nothing to do here.", "Button privileges revoked."]))
		"wrong_label":
			_teleport_button()
			main_button.text = _pick(["DON'T PRESS", "EXIT", "DELETE", "NO"])
			if announce: _say(_pick_fresh(["Read carefully.", "Words are trustworthy.", "This label means something."]))
		"late_move":
			_place_button_center()
			main_button.text = "PRESS"
			if announce: _say(_pick_fresh(["Normal one.", "Nothing weird.", "Go on."]))
		"pulse_target":
			_teleport_button()
			main_button.text = "PRESS"
			if announce: _say(_pick_fresh(["Breathing room.", "It's alive enough.", "Timing helps."]))

func _apply_modifiers() -> void:
	for m in current_modifiers:
		match m:
			"tilt":
				main_button.rotation = deg_to_rad(rng.randf_range(-28.0, 28.0))
			"dim":
				main_button.modulate.a *= rng.randf_range(0.48, 0.78)
			"jitter":
				pass
			"soft_move":
				_teleport_button()
			"narrow":
				main_button.size.x *= rng.randf_range(0.55, 0.72)
			"wide":
				main_button.size.x *= rng.randf_range(1.25, 1.65)
				_clamp_button_to_arena()
			"color_shift":
				var hue := rng.randf()
				button_normal = Color.from_hsv(hue, 0.52, 0.95)
				button_hover = button_normal.lightened(0.10)
				button_pressed = button_normal.darkened(0.12)
				_apply_button_style()
			"small_text":
				main_button.add_theme_font_size_override("font_size", rng.randi_range(12, 20))
			"quiet":
				speech.modulate.a = 0.55
			"restless":
				pass
			"offcenter":
				main_button.pivot_offset = Vector2(rng.randf_range(0.0, main_button.size.x), rng.randf_range(0.0, main_button.size.y))

func _handle_double() -> void:
	var now := Time.get_ticks_msec()
	if double_first_ms > 0 and now - double_first_ms <= DOUBLE_WINDOW_MS:
		double_first_ms = 0
		_success(_pick_fresh(["Two.", "Fine.", "You got it."]))
	else:
		double_first_ms = now
		main_button.text = "AGAIN"
		_say(_pick_fresh(["That was one.", "Again.", "One more."]))

func _handle_anti_spam() -> void:
	if intervals.is_empty():
		_success()
		return
	var latest: float = intervals.back()
	if latest < 0.48:
		misses += 1
		streak = 0
		_stat_fail("anti_spam")
		_say(_pick_fresh(["Too fast.", "Human speed, please.", "Suspicious rhythm.", "Nope."]))
		_teleport_button()
	else:
		_success(_pick_fresh(["Restraint. Impressive.", "Better.", "See? You can wait."]))

func _handle_wait() -> void:
	var now := Time.get_ticks_msec()
	if now < wait_allowed_ms:
		misses += 1
		streak = 0
		_stat_fail("wait")
		_say(_pick_fresh(["I literally said wait.", "Predictable.", "That was the test."]))
	else:
		_success(_pick_fresh(["NOW worked.", "Patient enough.", "Annoyingly correct."]))

func _handle_fake_lock() -> void:
	if fake_lock:
		fake_lock = false
		main_button.text = "..."
		_say(_pick_fresh(["Oh.", "You tried anyway.", "You don't trust labels. Good."]))
		get_tree().create_timer(rng.randf_range(0.35, 0.75)).timeout.connect(func():
			if current_behavior == "fake_lock":
				main_button.text = "FINE"
		)
	else:
		_success()

func _handle_sequence() -> void:
	if sequence_left <= 1:
		_success(_pick_fresh(["Counted.", "You can count.", "Fine."]))
		return
	sequence_left -= 1
	sequence_expected += 1
	main_button.text = str(sequence_expected)
	_teleport_button()
	_say(_pick_fresh(["Next.", "Keep up.", "Again."]))

func _handle_shrink() -> void:
	if shrink_clicks_left <= 1:
		_success(_pick_fresh(["Small enough.", "You kept going.", "There."]))
		return
	shrink_clicks_left -= 1
	main_button.size = Vector2(maxf(MIN_BUTTON_SIZE.x, main_button.size.x * 0.72), maxf(MIN_BUTTON_SIZE.y, main_button.size.y * 0.72))
	main_button.add_theme_font_size_override("font_size", maxi(13, 18 + shrink_clicks_left * 3))
	main_button.text = str(shrink_clicks_left)
	_teleport_button()

func _spawn_decoys(moving: bool) -> void:
	main_button.size = Vector2(210, 112)
	_teleport_button()
	main_button.text = _pick(["BUTTON", "ME", "REAL"])
	var count := rng.randi_range(2, clampi(3 + int(successes / 30), 3, 7))
	for i in range(count):
		var decoy := Button.new()
		decoy.text = _pick(["BUTTON", "ME", "PRESS", "REAL", "100% ME", "TRUST ME"])
		decoy.focus_mode = Control.FOCUS_NONE
		decoy.size = Vector2(rng.randf_range(155, 225), rng.randf_range(82, 118))
		decoy.add_theme_font_size_override("font_size", rng.randi_range(20, 28))
		decoy.add_theme_color_override("font_color", Color("#f7f2e8"))
		var decoy_color := Color.from_hsv(rng.randf(), 0.58, 0.72)
		decoy.add_theme_stylebox_override("normal", _panel_style(decoy_color, 28, Color("#ffffff55"), 2))
		decoy.add_theme_stylebox_override("hover", _panel_style(decoy_color.lightened(0.12), 28, Color("#ffffff"), 3))
		decoy.add_theme_stylebox_override("pressed", _panel_style(decoy_color.darkened(0.12), 28, Color("#ffffff"), 2))
		arena.add_child(decoy)
		decoys.append(decoy)
		_place_random(decoy)
		decoy.pressed.connect(_on_decoy_pressed.bind(decoy))
		if moving:
			_start_decoy_motion(decoy)

func _start_decoy_motion(decoy: Button) -> void:
	var duration := rng.randf_range(0.55, 1.25)
	var tween := create_tween().set_loops()
	var target := Vector2(rng.randf_range(8.0, maxf(9.0, arena.size.x - decoy.size.x - 8.0)), rng.randf_range(8.0, maxf(9.0, arena.size.y - decoy.size.y - 8.0)))
	tween.tween_property(decoy, "position", target, duration).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	tween.tween_callback(func():
		if is_instance_valid(decoy):
			var next_target := Vector2(rng.randf_range(8.0, maxf(9.0, arena.size.x - decoy.size.x - 8.0)), rng.randf_range(8.0, maxf(9.0, arena.size.y - decoy.size.y - 8.0)))
			decoy.position = next_target
	)

func _on_decoy_pressed(decoy: Button) -> void:
	_attempt_record()
	misses += 1
	streak = 0
	_stat_fail(current_behavior)
	decoy.text = _pick(["LOL", "NO", "WRONG", "NICE TRY", "DATA"])
	decoy.disabled = true
	_say(_pick_fresh(["You believed a button.", "Wrong rectangle.", "I wasn't even beige.", "Thank you for the data.", "Confidence is not evidence."]))
	_update_profile()
	_update_hud()
	_save_memory()

func _arm_wait_button(token: int) -> void:
	if token != wait_token:
		return
	if current_behavior == "wait" and Time.get_ticks_msec() >= wait_allowed_ms:
		main_button.disabled = false
		main_button.text = "NOW"
		_say(_pick_fresh(["NOW.", "Okay, now.", "Go."]))

func _maybe_rare_event() -> void:
	var chance := clampf(0.018 + successes * 0.00045, 0.018, 0.095)
	if rng.randf() > chance:
		return
	var rare_pool := ["title_lie", "fake_popup", "lights_out", "arena_message", "hud_lie", "button_clone", "memory_callout", "false_victory"]
	var rare := str(rare_pool[rng.randi_range(0, rare_pool.size() - 1)])
	if seen_rare.has(rare) and rng.randf() < 0.70:
		return
	seen_rare[rare] = int(seen_rare.get(rare, 0)) + 1
	match rare:
		"title_lie":
			title_label.text = _pick(["THE OTHER BUTTON", "NOT THE BUTTON", "THE LAST BUTTON", "SETTINGS"])
			get_tree().create_timer(2.4).timeout.connect(func(): title_label.text = "THE BUTTON")
		"fake_popup":
			_spawn_fake_popup()
		"lights_out":
			var old := background.color
			background.color = Color("#000000")
			main_button.modulate.a = 0.70
			get_tree().create_timer(1.8).timeout.connect(func(): background.color = old)
		"arena_message":
			_spawn_arena_word(_pick(["WHY", "NO", "STOP", "AGAIN", "HELLO"]))
		"hud_lie":
			var real := successes
			count_label.text = "WINS  %d" % (real + rng.randi_range(37, 999))
			get_tree().create_timer(1.6).timeout.connect(_update_hud)
		"button_clone":
			_spawn_one_clone()
		"memory_callout":
			_say(_memory_line())
		"false_victory":
			_say(_pick_fresh(["You won.", "That's it. You beat me.", "Game complete."]))
			get_tree().create_timer(1.4).timeout.connect(func(): _say(_pick_fresh(["No.", "Obviously not.", "You believed me."])))

func _spawn_fake_popup() -> void:
	var panel := PanelContainer.new()
	panel.size = Vector2(minf(520, arena.size.x * 0.82), 190)
	panel.position = (arena.size - panel.size) * 0.5
	panel.add_theme_stylebox_override("panel", _panel_style(Color("#f0f0f0"), 18, Color("#ffffff"), 2))
	arena.add_child(panel)
	extra_labels.append(panel)
	var label := Label.new()
	label.text = _pick(["An error has occurred.\nReason: you pressed it.", "Update required.\nButton behavior improved without consent.", "Achievement unlocked:\nPoor impulse control."])
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	label.add_theme_font_size_override("font_size", 24)
	label.add_theme_color_override("font_color", Color("#161820"))
	panel.add_child(label)
	get_tree().create_timer(1.9).timeout.connect(func():
		if is_instance_valid(panel): panel.queue_free()
	)

func _spawn_arena_word(word: String) -> void:
	var label := Label.new()
	label.text = word
	label.add_theme_font_size_override("font_size", rng.randi_range(70, 130))
	label.add_theme_color_override("font_color", Color("#ffffff18"))
	label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	arena.add_child(label)
	extra_labels.append(label)
	label.position = Vector2(rng.randf_range(20, maxf(21, arena.size.x - 260)), rng.randf_range(20, maxf(21, arena.size.y - 150)))
	var tween := create_tween()
	tween.tween_property(label, "modulate:a", 0.0, 1.7)
	tween.tween_callback(label.queue_free)

func _spawn_one_clone() -> void:
	var clone := Button.new()
	clone.text = main_button.text
	clone.size = main_button.size
	clone.add_theme_font_size_override("font_size", 28)
	clone.add_theme_color_override("font_color", ink)
	clone.add_theme_stylebox_override("normal", _panel_style(button_normal, 38, Color("#ffffff"), 3))
	arena.add_child(clone)
	decoys.append(clone)
	_place_random(clone)
	clone.pressed.connect(_on_decoy_pressed.bind(clone))

func _update_profile() -> void:
	if attempts < 4:
		current_profile = "UNKNOWN"
		return
	var miss_rate: float = float(misses) / maxf(1.0, float(attempts))
	var avg := _average_recent(intervals, 10)
